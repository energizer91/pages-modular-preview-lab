{
  "name": "pages-modular-preview-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/publish.mjs site=.local/dev package=dist/package pr=main sha=local && node scripts/serve.mjs .local/dev",
    "prepare": "panda codegen",
    "build": "panda codegen && tsc --noEmit && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/serve.mjs .local/dev",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "5.40.0",
    "@module-federation/enhanced": "2.9.3",
    "@module-federation/vite": "1.23.10",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/preset-panda": "2.5.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
